{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LlamaHarness",
  "version": "0.1.0",
  "identifier": "com.axggdzz.llamaharness",
  "build": {
    "frontendDist": "./dist",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LlamaHarness for macOS",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "hiddenTitle": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:8080; connect-src 'self' http://127.0.0.1:8080; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Local llama.cpp gateway and dashboard"
  }
}
